# === Java / Maven (Rezkna-Backend services) ===
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# === Node (Rezkna-Frontend) ===
# Rezkna-Frontend/.gitignore (generated by the React Native CLI) covers the
# platform-specific details precisely (Android/iOS build dirs, debug.keystore
# exception, Gradle/CocoaPods, Metro cache, etc.) - this just covers the
# top-level Node concern relevant repo-wide.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/

# === Certificates / signing keys (repo-wide, not just mobile) ===
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# === Environment / secrets ===
.env
.env.*
!.env.example
*.env
!*.env.example

# === IDE ===
.idea/
*.iml
.vscode/
*.swp

# === OS ===
.DS_Store
Thumbs.db

# === Docker ===
docker-compose.override.yml

# === Logs ===
*.log
logs/

# === Accidentally-downloaded credential exports (e.g. MongoDB Atlas "create user" download) ===
*_db_user.txt

# === Internal docs with production infra details (not for GitHub) ===
rezkna-plan-sprints-microservices.pdf
rezkna-technical-documentation.pdf
