# Copy this file to .env and fill in real values. .env is git-ignored and must
# never be committed.

# MongoDB Atlas (shared cluster, one database per service - see docker-compose.yml)
MONGODB_ATLAS_USER=your-atlas-username
MONGODB_ATLAS_PASSWORD=your-atlas-password
MONGODB_ATLAS_HOST=clusterXXXXX.mongodb.net

# Shared HMAC secret used by every service to validate JWTs (HS256 requires >= 32 bytes).
# Generate your own for local dev, e.g.: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
